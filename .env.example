# Omni-Engine core (products/animind_core), e.g. http://127.0.0.1:8787. Legacy name: CORE_URL.
# Next.js proxies read only this URL and the key below. Leave both empty in git.
ANIMIND_CORE_URL=
# Server-only bearer token, same value as the core's CORE_API_KEY. Never expose with NEXT_PUBLIC_.
ANIMIND_CORE_KEY=
# Dev only: set to 1 to use the built-in mock when ANIMIND_CORE_URL is empty. Without either, the API answers 503.
ANIMIND_CORE_MOCK=
# Gitignored directory for the local account file and object storage (puppet.json + PNG layers).
# Default when empty: ./.data — do not point this at a tracked folder.
# Local `npm run dev` uses this directory when the hosted variables below are empty.
ANIMIND_DATA_DIR=
# HMAC secret for the session cookie and the Google state cookie. Required in both modes.
# At least 16 characters. Never commit the value.
ANIMIND_AUTH_SECRET=
# Public origin for Google OAuth (scheme + host, no path). The redirect URI is {origin}/api/auth/google/callback.
# Local (Windows, npm run dev): leave empty, or set http://localhost:3000. Opening http://localhost:3000
# always uses that origin, even when this variable points at Vercel. Register that exact URI in Google Cloud.
# 127.0.0.1 is a different URI (http://127.0.0.1:3000/api/auth/google/callback) and must be registered separately.
# Vercel: https://<project>-git-feat-mvp-ui-<team>.vercel.app or the production origin. No path, no trailing slash required.
ANIMIND_AUTH_URL=
# Google OAuth web client. Both are required for "Entrar com Google" in either mode. Never commit the secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. 1 forces the Secure cookie flag; 0 turns it off.
# Leave empty locally so http://localhost keeps the cookie. On Vercel the flag follows HTTPS.
ANIMIND_COOKIE_SECURE=
# Pilot super admin (display name Diogo). Used only by `npm run seed`. Never commit the password.
# SEED_SUPERADMIN_EMAIL must be Diogo's Google address so that login links to this super_admin.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
# Hosted accounts. Leave BOTH empty for local ./.data (npm run dev on Windows or anywhere else).
# An empty value is the same as unset. When either is set, accounts leave ./.data and go to Neon.
# On a Preview deploy, connect Neon to Preview and Development, and do not create a database
# branch per preview, or the seeded rows will not be the database the preview reads.
DATABASE_URL=
POSTGRES_URL=
# Hosted files. Leave BOTH empty for local ./.data/objects.
# Vercel Blob sets BLOB_STORE_ID on the deployment (OIDC via VERCEL_OIDC_TOKEN, which Vercel injects).
# BLOB_READ_WRITE_TOKEN is the static token for `npm run seed` / `npm run import-character` outside Vercel.
# Create the store as Public. Set ANIMIND_BLOB_ACCESS=private only when the store itself is private.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
ANIMIND_BLOB_ACCESS=
# Image and script keys stay on the core process, never in this app:
# GEMINI_API_KEY, DEEPSEEK_API_KEY, TOGETHER_API_KEY, OPENROUTER_API_KEY.
# Without them the core still cuts an offline rig and speaks with edge-tts.
# Gemini cost cap per character lives on the core, not here: REEL_REEL_BUDGET_USD,
# MAX_GOOGLE_COST_PER_RUN_USD (~0.15 fits side + front + open mouth) and
# GOOGLE_COST_ALLOW_ABOVE_CEILING=1. See Omni-Engine products/animind_core/.env.example.
